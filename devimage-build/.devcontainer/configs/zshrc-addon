# zsh 主题（随机）
ZSH_THEME="random"

# zsh 插件
plugins=(git z sudo zsh-autosuggestions zsh-syntax-highlighting)

# 实用别名
alias ll="eza -la"
alias bat="batcat"
alias cat="bat"
alias find="fd"
alias grep="rg"

# tmux 快捷键
alias ta='tmux attach -t'
alias tn='tmux new -s'
alias tl='tmux ls'
alias tk='tmux kill-session -t'
